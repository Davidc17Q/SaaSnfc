# Servidor
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://nfc_admin:nfc_secret@localhost:5432/nfc_saas

# Redis
REDIS_URL=redis://localhost:6379

# Zona horaria del negocio (para filtros de fecha y gráficos del dashboard)
APP_TIMEZONE=America/Bogota

# Autenticación del panel (CAMBIA estos valores en producción)
AUTH_USER=admin
AUTH_PASSWORD=cambia-esta-clave
SESSION_SECRET=genera-un-secreto-largo-y-aleatorio
SESSION_HOURS=168

# Anti-doble-conteo: segundos que un mismo dispositivo+IP no vuelve a contar (0 = off)
SCAN_DEDUPE_SECONDS=30

# Correo SMTP (Función 2, Fase B: envío de informes). Si SMTP_HOST queda vacío,
# el envío por correo se desactiva (el panel lo avisa) y solo se usa el PDF.
# Ejemplo con Gmail (requiere "contraseña de aplicación"): host smtp.gmail.com, puerto 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NFCloud <no-reply@tudominio.com>

# Avisos por WhatsApp / SMS (Twilio). Opcional; guía en documentos/AVISOS-WHATSAPP-TWILIO.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WA_CONTENT_SID=
TWILIO_SMS_FROM=

# Competencia en Google (Places API New). Opcional; guía en documentos/COMPETENCIA-GOOGLE.md
GOOGLE_PLACES_API_KEY=
